{
  "$id": "https://eplabsai.com/pulsemech/schemas/anchor_integrity_execution_request_v0_1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "binding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "claim_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "relation_type": {
          "enum": [
            "supports",
            "contradicts",
            "derived_from",
            "contextualizes",
            "references"
          ],
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "claim_id",
        "claim_digest",
        "evidence_id",
        "source_id",
        "source_sha256",
        "evidence_sha256",
        "relation_type"
      ],
      "type": "object"
    },
    "candidate_status": {
      "const": "diagnostic_only"
    },
    "challenge": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "entrypoint": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.\\-/]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 8388608,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "execution_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "implementation_scope": {
      "const": "entrypoint_bytes_only"
    },
    "inputs": {
      "additionalProperties": false,
      "properties": {
        "claim_text": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.\\-/]+$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "size_bytes": {
              "maximum": 8388608,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "type": "object"
        },
        "evidence_content": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.\\-/]+$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "size_bytes": {
              "maximum": 8388608,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "type": "object"
        },
        "source_content": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.\\-/]+$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "size_bytes": {
              "maximum": 8388608,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "type": "object"
        }
      },
      "required": [
        "claim_text",
        "evidence_content",
        "source_content"
      ],
      "type": "object"
    },
    "invocation": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\u0000]*$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "cwd_label": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\u0000]*$",
          "type": "string"
        },
        "environment": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "pattern": "^[A-Z_][A-Z0-9_]{0,63}$",
                "type": "string"
              },
              "value": {
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "argv",
        "cwd_label",
        "environment"
      ],
      "type": "object"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "max_stderr_bytes": {
          "maximum": 1048576,
          "minimum": 0,
          "type": "integer"
        },
        "max_stdout_bytes": {
          "maximum": 1048576,
          "minimum": 1,
          "type": "integer"
        },
        "timeout_ms": {
          "maximum": 3600000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "timeout_ms",
        "max_stdout_bytes",
        "max_stderr_bytes"
      ],
      "type": "object"
    },
    "profile": {
      "const": "single-record-execution-contract-v1"
    },
    "release_authority_activation": {
      "const": false
    },
    "runtime_manifest": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.\\-/]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 8388608,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "anchor_integrity_execution_request_v0_1"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "run_id"
      ],
      "type": "object"
    },
    "verifier": {
      "additionalProperties": false,
      "properties": {
        "implementation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "method_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "method_version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "verifier_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "verifier_id",
        "method_id",
        "method_version",
        "implementation_sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "candidate_status",
    "authority_effect",
    "release_authority_activation",
    "profile",
    "execution_id",
    "challenge",
    "subject",
    "verifier",
    "binding",
    "implementation_scope",
    "entrypoint",
    "runtime_manifest",
    "inputs",
    "invocation",
    "limits"
  ],
  "title": "anchor_integrity_execution_request_v0_1 - diagnostic contract only",
  "type": "object"
}
