            "date_epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4102444800
            },
            "valid_until_epoch": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4102444800
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "required": [
