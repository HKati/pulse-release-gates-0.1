          "properties": {
            "compressed": {
              "$ref": "#/$defs/compressed_index"
            },
            "decoded": {
              "$ref": "#/$defs/decoded_index"
            },
            "package_paragraphs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250000
            }
          }
        },
        "package": {
          "$ref": "#/$defs/package"
        }
      }
