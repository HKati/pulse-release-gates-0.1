{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulsemech:required-gate-idempotence-launcher-distribution:v0",
  "title": "Externally selected detached-Release launcher distribution relationships v0",
  "description": "Authenticates the selected distribution chain under an explicit external trust policy; preserves all former host, execution, build-origin and authority boundaries.",
  "$ref": "#/$defs/selection",
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "fingerprint": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9A-F]{40}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9_.+~\\-]+(?:/[A-Za-z0-9_.+~\\-]+)*$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 500,
      "pattern": "^/[A-Za-z0-9_.+~\\-]+(?:/[A-Za-z0-9_.+~\\-]+)*$"
    },
    "control_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "launch_host_binding": {
      "type": "object",
      "additionalProperties": false,
