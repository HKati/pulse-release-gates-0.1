          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[ -~]+$"
        },
        "codename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[ -~]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[ -~]+$"
        },
        "component": {
          "$ref": "#/$defs/relative_path"
