{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "baseline_case_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "input_id": {
          "$ref": "#/$defs/id"
        },
        "variant_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "case_id",
        "input_id",
        "baseline_case_id",
        "variant_id"
      ],
      "type": "object"
    },
    "expected_occurrence": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "occurrence_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "occurrence_id",
        "case_id"
      ],
      "type": "object"
    },
    "file_reference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "maximum": 4194304,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "gate_id": {
      "pattern": "^[a-z][a-z0-9_]{0,127}(?![\\s\\S])",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}(?![\\s\\S])",
      "type": "string"
    },
    "input_binding": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "maximum": 4194304,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "input_id",
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "obligation": {
      "additionalProperties": false,
      "properties": {
        "case_ids": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "gate_id": {
          "$ref": "#/$defs/gate_id"
        },
        "obligation_id": {
          "$ref": "#/$defs/id"
        },
        "occurrence_ids": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "obligation_id",
        "gate_id",
        "case_ids",
        "occurrence_ids"
      ],
      "type": "object"
    },
    "occurrence": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "execution_id": {
          "maxLength": 256,
          "pattern": "^execution:[A-Za-z0-9._:/@+-]+(?![\\s\\S])",
          "type": "string"
        },
        "input_state_ids": {
          "items": {
            "maxLength": 256,
            "pattern": "^state:[A-Za-z0-9._:/@+-]+(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "occurrence_id": {
          "$ref": "#/$defs/id"
        },
        "output_state_ids": {
          "items": {
            "maxLength": 256,
            "pattern": "^state:[A-Za-z0-9._:/@+-]+(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "packet_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "occurrence_id",
        "case_id",
        "packet_id",
        "execution_id",
        "input_state_ids",
        "output_state_ids"
      ],
      "type": "object"
    },
    "origin": {
      "enum": [
        "synthetic_fixture",
        "reviewed_declaration"
      ]
    },
    "path": {
      "maxLength": 400,
      "pattern": "^(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9_.-]+(?:/(?!(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9_.-]+)*(?![\\s\\S])",
      "type": "string"
    },
    "protocol": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "$ref": "#/$defs/case"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "decisions": {
          "additionalProperties": false,
          "properties": {
            "comparison": {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "observation_mapping": {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "operator_semantics": {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "privacy_retention": {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "subject_selection": {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "required": [
            "subject_selection",
            "operator_semantics",
            "comparison",
            "privacy_retention",
            "observation_mapping"
          ],
          "type": "object"
        },
        "expected_occurrences": {
          "items": {
            "$ref": "#/$defs/expected_occurrence"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/obligation"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "record_type": {
          "const": "required_gate_suite_protocol_v0"
        },
        "selected_gate_ids": {
          "items": {
            "$ref": "#/$defs/gate_id"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "suite_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "record_type",
        "origin",
        "suite_id",
        "source",
        "selected_gate_ids",
        "cases",
        "expected_occurrences",
        "obligations",
        "decisions"
      ],
      "type": "object"
    },
    "selection": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "additionalProperties": false,
          "properties": {
            "checker_source": {
