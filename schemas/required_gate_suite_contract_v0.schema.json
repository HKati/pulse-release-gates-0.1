            {
              "type": "null"
            }
          ]
        },
        "subject_packet": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "protocol",
        "operator",
        "comparison",
        "privacy",
        "observation_mapping",
        "subject_packet",
        "runtime_packet"
      ],
      "type": "object"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/case"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "declaration_state": {
      "enum": [
        "draft",
        "complete"
      ]
    },
    "obligations": {
      "items": {
        "$ref": "#/$defs/obligation"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "occurrences": {
