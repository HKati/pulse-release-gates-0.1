  "$id": "https://github.com/HKati/pulse-release-gates-0.1/schemas/required_gate_suite_contract_v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "unresolved_decisions": {
            "minItems": 1
          }
        }
      },
      "if": {
        "properties": {
          "declaration_state": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "binding_sha256": {
            "properties": {
              "comparison": {
                "$ref": "#/$defs/sha256"
              },
              "observation_mapping": {
                "$ref": "#/$defs/sha256"
              },
              "operator": {
                "$ref": "#/$defs/sha256"
              },
              "privacy": {
                "$ref": "#/$defs/sha256"
              },
              "protocol": {
                "$ref": "#/$defs/sha256"
              },
              "runtime_packet": {
                "$ref": "#/$defs/sha256"
              },
              "subject_packet": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "cases": {
            "minItems": 1
          },
          "obligations": {
            "minItems": 1
          },
          "occurrences": {
            "minItems": 1
          },
          "unresolved_decisions": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "description": "Closed draft/complete declaration contract with externally selected byte bindings. Complete means declaration completeness only. No execution, semantic verification, metric result, or authority is established.",
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "binding_sha256": {
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_mapping": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "operator": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "privacy": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_packet": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
