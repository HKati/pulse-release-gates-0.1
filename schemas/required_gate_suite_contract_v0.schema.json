    },
    "record_type": {
      "const": "required_gate_suite_contract_v0"
    },
    "selected_gate_ids": {
      "items": {
        "$ref": "#/$defs/gate_id"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "suite_id": {
      "$ref": "#/$defs/id"
    },
    "unresolved_decisions": {
