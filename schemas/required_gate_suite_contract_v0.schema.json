            "contract_schema": {
              "$ref": "#/$defs/file_reference"
            },
            "observation_mapping": {
              "anyOf": [
                {
                  "$ref": "#/$defs/file_reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "operator": {
              "anyOf": [
                {
                  "$ref": "#/$defs/file_reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "policy": {
              "$ref": "#/$defs/file_reference"
            },
            "privacy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/file_reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "protocol": {
              "anyOf": [
                {
                  "$ref": "#/$defs/file_reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "registry": {
              "$ref": "#/$defs/file_reference"
            },
            "runtime_packet": {
              "anyOf": [
                {
                  "$ref": "#/$defs/file_reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "runtime_schema": {
              "$ref": "#/$defs/file_reference"
            },
            "source_anchor": {
              "$ref": "#/$defs/file_reference"
            },
            "subject_packet": {
              "anyOf": [
                {
                  "$ref": "#/$defs/file_reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "subject_schema": {
              "$ref": "#/$defs/file_reference"
            }
          },
          "required": [
            "contract_schema",
            "checker_source",
            "policy",
            "registry",
            "subject_schema",
            "runtime_schema",
            "source_anchor",
            "protocol",
            "operator",
            "comparison",
            "privacy",
            "observation_mapping",
            "subject_packet",
            "runtime_packet"
          ],
          "type": "object"
        },
        "contract": {
          "$ref": "#/$defs/file_reference"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/input_binding"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "record_type": {
          "const": "required_gate_suite_selection_v0"
        },
        "selected_gate_ids": {
          "items": {
            "$ref": "#/$defs/gate_id"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "record_type",
        "origin",
        "source",
        "selected_gate_ids",
        "contract",
        "bindings",
        "inputs"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])",
          "type": "string"
        },
        "repository": {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit"
      ],
      "type": "object"
    },
    "unresolved": {
      "enum": [
        "protocol",
        "subject",
        "operator",
        "cases",
        "comparison",
        "privacy_retention",
        "observation_mapping",
        "runtime_evidence"
      ]
    }
