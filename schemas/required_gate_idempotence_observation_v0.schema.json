{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulsemech:required-gate-idempotence-observation:v0",
  "title": "Selected standalone operator acquisition and derived-input observation v0",
  "description": "Closed selected-byte and capture-record shapes. Schema validity alone proves no source, consumption, execution, metric or release claim.",
  "oneOf": [
    {
      "$ref": "#/$defs/selection"
    },
    {
      "$ref": "#/$defs/context"
    },
    {
      "$ref": "#/$defs/receipts"
    },
    {
      "$ref": "#/$defs/inventory"
    }
  ],
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_implementation",
        "python_version",
        "unicode_version",
        "os_name",
        "architecture",
        "executable_sha256"
      ],
      "properties": {
        "python_implementation": {
          "const": "CPython"
        },
        "python_version": {
          "const": "3.11.16"
        },
        "unicode_version": {
          "const": "14.0.0"
        },
        "os_name": {
          "const": "Linux"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@+-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "source_revision",
        "sha256",
        "size_bytes",
        "member"
      ],
      "properties": {
        "role": {
          "enum": [
            "worker",
            "collector",
            "operator",
            "operator_dependency",
            "implementation_dependency"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 524288
        },
        "member": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "first_application_id",
        "second_application_id"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^idem-(0[1-9]|1[0-2])$"
        },
        "first_application_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "second_application_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_status",
        "profile",
        "protocol_id",
        "repository",
        "source_commit",
        "acquisition_id",
        "acquisition_attempt",
        "configuration",
        "environment",
        "sources",
        "applications",
        "execution_authorized",
        "production_gate_eligible",
        "authority_effect"
      ],
      "properties": {
        "record_type": {
          "const": "required_gate_idempotence_selection_v0"
        },
        "record_status": {
          "enum": [
            "example",
            "observed"
          ]
        },
        "profile": {
          "const": "standalone_operator_v0"
        },
        "protocol_id": {
          "const": "epf_snapshot_idempotence_v0"
        },
        "repository": {
          "const": "HKati/pulse-release-gates-0.1"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "acquisition_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@+-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "acquisition_attempt": {
          "type": "integer",
          "const": 1
        },
        "configuration": {
          "const": {
            "max_depth": 2,
            "max_items": 3,
            "allowed_prefixes": [
              "metrics"
            ],
            "deny_keys": [
              "metrics.pii",
              "metrics.secret"
            ]
          }
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 6,
          "maxItems": 32
        },
        "applications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/application"
          },
          "minItems": 12,
          "maxItems": 12
        },
        "execution_authorized": {
          "const": false
        },
        "production_gate_eligible": {
          "const": false
        },
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "process_id",
        "source_path",
        "source_revision",
        "command_sha256",
        "arguments_sha256",
        "exit_code"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "pattern": "^execution:[A-Za-z0-9._:@+-]+$",
          "maxLength": 200
        },
        "process_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "command_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "arguments_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_status",
        "selection_sha256",
        "acquisition_id",
        "acquisition_attempt",
        "repository",
        "source_commit",
        "environment",
        "started_utc",
        "completed_utc",
        "started_monotonic_ns",
        "completed_monotonic_ns",
        "collector"
      ],
      "properties": {
        "record_type": {
          "const": "standalone_operator_capture_context_v0"
        },
        "record_status": {
          "enum": [
            "example",
            "observed"
          ]
        },
        "selection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "acquisition_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@+-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "acquisition_attempt": {
          "type": "integer",
          "const": 1
        },
        "repository": {
          "const": "HKati/pulse-release-gates-0.1"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "started_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "completed_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "started_monotonic_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "completed_monotonic_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "collector": {
          "$ref": "#/$defs/collector"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_id",
        "case_id",
        "phase",
        "execution_id",
        "process_id",
        "source_path",
        "source_revision",
        "configuration_sha256",
        "environment_sha256",
        "command_sha256",
        "arguments_sha256",
        "started_utc",
        "completed_utc",
        "started_monotonic_ns",
        "completed_monotonic_ns",
        "exit_code",
        "capture_status",
        "input",
        "snapshot",
        "metadata",
        "stderr"
      ],
      "properties": {
        "application_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "phase": {
          "enum": [
            "first",
            "second"
          ]
        },
        "execution_id": {
          "type": "string",
          "pattern": "^execution:[A-Za-z0-9._:@+-]+$",
          "maxLength": 200
        },
        "process_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "command_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "arguments_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "started_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "completed_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "started_monotonic_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "completed_monotonic_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "capture_status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state_id",
            "member",
            "sha256",
            "size_bytes",
            "read_sha256",
            "read_size_bytes",
            "read_complete"
          ],
          "properties": {
            "state_id": {
              "type": "string",
              "pattern": "^state:[A-Za-z0-9._:@+-]+$",
              "maxLength": 200
            },
            "member": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 524288
            },
            "read_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "read_size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "read_complete": {
              "type": "boolean"
            }
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state_id",
            "member",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "state_id": {
              "type": "string",
              "pattern": "^state:[A-Za-z0-9._:@+-]+$",
              "maxLength": 200
            },
            "member": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 524288
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state_id",
            "member",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "state_id": {
              "type": "string",
              "pattern": "^state:[A-Za-z0-9._:@+-]+$",
              "maxLength": 200
            },
            "member": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 524288
            }
          }
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state_id",
            "member",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "state_id": {
              "type": "string",
              "pattern": "^state:[A-Za-z0-9._:@+-]+$",
              "maxLength": 200
            },
            "member": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 524288
            }
          }
        }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_status",
        "selection_sha256",
        "applications"
      ],
      "properties": {
        "record_type": {
          "const": "standalone_operator_application_receipts_v0"
        },
        "record_status": {
          "enum": [
            "example",
            "observed"
          ]
        },
        "selection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "applications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receipt"
          },
          "minItems": 24,
          "maxItems": 24
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "members"
      ],
      "properties": {
        "record_type": {
          "const": "standalone_operator_member_inventory_v0"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "member",
              "sha256",
              "size_bytes"
            ],
            "properties": {
              "member": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 524288
              }
            }
          },
          "minItems": 96,
          "maxItems": 122
        }
      }
    }
  }
}
