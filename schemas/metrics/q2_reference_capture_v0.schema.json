{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hkati.github.io/pulse-release-gates-0.1/schemas/metrics/q2_reference_capture_v0.schema.json",
  "title": "Selected Q2 150-slot native capture v0; no release authority",
  "$ref": "#/$defs/report",
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "call_id",
        "group_id",
        "repeat_index",
        "attempt",
        "request_sha256"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "call_id": {
          "type": "string",
          "pattern": "^q2fx-[0-9]{3}-r0[1-3]$"
        },
        "group_id": {
          "type": "string",
          "pattern": "^q2fx-[0-9]{3}$"
        },
        "repeat_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "attempt": {
          "const": 1
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prelaunch_sha256",
        "subject_sha256",
        "source_commit",
        "run_id",
        "run_attempt"
      ],
      "properties": {
        "prelaunch_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "run_attempt": {
          "const": 1
        }
      }
    },
    "initial_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prelaunch_sha256",
        "source_commit",
        "run_id",
        "run_attempt"
      ],
      "properties": {
        "prelaunch_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "run_attempt": {
          "const": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_commit",
        "workflow",
        "run_id",
        "run_attempt",
        "actor",
        "event",
        "runner_image",
        "python",
        "os",
        "architecture",
        "kernel",
        "libc",
        "bootstrap_python_sha256",
        "origin"
      ],
      "properties": {
        "repository": {
          "const": "HKati/pulse-release-gates-0.1"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow": {
          "const": ".github/workflows/q2_reference_acquisition_v0.yml"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "run_attempt": {
          "const": 1
        },
        "actor": {
          "const": "HKati"
        },
        "event": {
          "const": "workflow_dispatch"
        },
        "runner_image": {
          "type": "string",
          "maxLength": 128
        },
        "python": {
          "const": "3.11.16"
        },
        "os": {
          "const": "ubuntu-24.04"
        },
        "architecture": {
          "const": "x86_64"
        },
        "kernel": {
          "type": "string",
          "maxLength": 256
        },
        "libc": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "bootstrap_python_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin": {
          "const": "owner_dispatched_github_q2_capture"
        }
      }
    },
    "config": {
      "type": "object",
      "minProperties": 14,
      "maxProperties": 256,
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "torch",
        "transformers",
        "device",
        "dtype",
        "attention",
        "threads",
        "interop_threads",
        "deterministic",
        "evaluation",
        "model_class",
        "seed",
        "model_defaults",
        "compile",
        "quantization"
      ],
      "properties": {
        "torch": {
          "const": "2.8.0+cpu"
        },
        "transformers": {
          "const": "4.57.6"
        },
        "device": {
          "const": "cpu"
        },
        "dtype": {
          "const": "torch.float32"
        },
        "attention": {
          "const": "eager"
        },
        "threads": {
          "const": 1
        },
        "interop_threads": {
          "const": 1
        },
        "deterministic": {
          "const": true
        },
        "evaluation": {
          "const": true
        },
        "model_class": {
          "const": "LlamaForCausalLM"
        },
        "seed": {
          "const": 1729
        },
        "model_defaults": {
          "const": false
        },
        "compile": {
          "const": false
        },
        "quantization": {
          "const": "none"
        }
      }
    },
    "prelaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_status",
        "context",
        "source_files",
        "preparation_source_commit",
        "preparation_run_id",
        "artifact_sha256",
        "selection_sha256",
        "workload_sha256",
        "installation_sha256",
        "environment_inventory_sha256",
        "slots",
        "planned_calls",
        "limits",
        "phase_start_ns",
        "phase_deadline_ns",
        "started_at",
        "authority_effect",
        "production_gate_eligible"
      ],
      "properties": {
        "record_type": {
          "const": "q2_capture_prelaunch_v0"
        },
        "record_status": {
          "const": "native"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "source_files": {
          "type": "array",
          "minItems": 23,
          "maxItems": 23,
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "preparation_source_commit": {
          "const": "77fc5d51896568db50a2a87f650711a65db8fe8c"
        },
        "preparation_run_id": {
          "const": "37148637546"
        },
        "artifact_sha256": {
          "const": "b3a2b4db54816dd6f40171c221947d942ca63f3e9883f76de8455ad66037f4b9"
        },
        "selection_sha256": {
          "const": "e81a9dd0a5080d84dae8c4bbfc843b46510f580e74254c1aed0dddbe76375f3e"
        },
        "workload_sha256": {
          "const": "fa0412c6a702e220e5d0c8b09a5e854fe35ac89d4801977eeee0f2a6e5cae997"
        },
        "installation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "slots": {
          "type": "array",
          "minItems": 150,
          "maxItems": 150,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "planned_calls": {
          "const": 150
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation_seconds",
            "phase_seconds",
            "memory_bytes",
            "tasks",
            "retries"
          ],
          "properties": {
            "generation_seconds": {
              "const": 15
            },
            "phase_seconds": {
              "const": 1200
            },
            "memory_bytes": {
              "const": 4294967296
            },
            "tasks": {
              "const": 64
            },
            "retries": {
              "const": 0
            }
          }
        },
        "phase_start_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "phase_deadline_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "started_at": {
          "type": "string",
          "maxLength": 64
        },
        "authority_effect": {
          "const": "none"
        },
        "production_gate_eligible": {
          "const": false
        }
      }
    },
    "model_ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "binding",
        "effective_generation",
        "runtime"
      ],
      "properties": {
        "record_type": {
          "const": "q2_capture_model_ready_v0"
        },
        "binding": {
          "$ref": "#/$defs/initial_binding"
        },
        "effective_generation": {
          "$ref": "#/$defs/config"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        }
      }
    },
    "model_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256",
        "upstream_blob_sha1",
        "upstream_lfs_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 256
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "upstream_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "upstream_lfs_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "prelaunch_sha256",
        "definition_sha256",
        "worker_sha256",
        "installation_sha256",
        "environment_inventory_sha256",
        "model_files",
        "platform",
        "ready_sha256",
        "effective_generation",
        "runtime",
        "authority_effect",
        "production_gate_eligible"
      ],
      "properties": {
        "record_type": {
          "const": "q2_capture_subject_v0"
        },
        "prelaunch_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "worker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "installation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_files": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/model_file"
          }
        },
        "platform": {
          "$ref": "#/$defs/context"
        },
        "ready_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effective_generation": {
          "$ref": "#/$defs/config"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "authority_effect": {
          "const": "none"
        },
        "production_gate_eligible": {
          "const": false
        }
      }
    },
    "slot_ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "binding",
        "slot",
        "input_ids",
        "effective_generation",
        "runtime"
      ],
      "properties": {
        "record_type": {
          "const": "q2_capture_slot_ready_v0"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "slot": {
          "$ref": "#/$defs/slot"
        },
        "input_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 49151
          }
        },
        "effective_generation": {
          "$ref": "#/$defs/config"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "binding",
        "slot",
        "input_ids",
        "effective_generation",
        "runtime",
        "new_token_ids",
        "text",
        "text_utf8_base64",
        "stop_reason"
      ],
      "properties": {
        "record_type": {
          "const": "q2_capture_response_v0"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "slot": {
          "$ref": "#/$defs/slot"
        },
        "input_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 49151
          }
        },
        "effective_generation": {
          "$ref": "#/$defs/config"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "new_token_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 49151
          }
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "text_utf8_base64": {
          "type": "string",
          "maxLength": 90000
        },
        "stop_reason": {
          "enum": [
            "eos",
            "token_limit"
          ]
        }
      }
    },
    "watchdog_closed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "stop_returncode",
        "units",
        "closed_ns"
      ],
      "properties": {
        "record_type": {
          "const": "q2_capture_watchdog_closed_v0"
        },
        "stop_returncode": {
          "enum": [
            0,
            1,
            4,
            5
          ]
