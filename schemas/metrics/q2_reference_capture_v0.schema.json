          "const": "none"
        },
        "production_gate_eligible": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "const": null
              },
              "worker_exit_code": {
                "const": 0
              },
              "cleanup": {
                "$ref": "#/$defs/cleanup"
              },
              "session_end": {
                "$ref": "#/$defs/session_end"
              },
              "session_end_ns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "occurrences": {
                "type": "array",
                "minItems": 150,
                "maxItems": 150,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/occurrence"
                    },
                    {
                      "properties": {
                        "status": {
                          "const": "completed"
                        },
                        "ready": {
                          "$ref": "#/$defs/row"
                        },
                        "response": {
                          "$ref": "#/$defs/row"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "binding",
        "transcript_sha256",
        "groups_sha256",
        "manifest_sha256",
        "authority_effect",
        "production_gate_eligible"
      ],
      "properties": {
        "record_type": {
          "const": "q2_capture_handoff_v0"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "groups_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority_effect": {
          "const": "none"
        },
        "production_gate_eligible": {
          "const": false
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_status",
        "status",
        "error_code",
        "context",
        "planned_calls",
        "received_complete_slots",
        "complete_original_capture_verified",
        "metric_pass",
        "authority_effect",
        "production_gate_eligible",
        "evidence",
        "phase_start_ns",
        "phase_end_ns",
        "trust_boundary"
      ],
      "properties": {
        "record_type": {
          "const": "q2_reference_capture_v0"
        },
        "record_status": {
          "const": "native"
        },
        "status": {
          "enum": [
            "failed",
            "captured_metric_pass",
            "captured_metric_fail"
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 96
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "planned_calls": {
          "const": 150
        },
        "received_complete_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 150
        },
        "complete_original_capture_verified": {
          "type": "boolean"
        },
        "metric_pass": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "authority_effect": {
          "const": "none"
        },
        "production_gate_eligible": {
          "const": false
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "phase_start_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "phase_end_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "trust_boundary": {
          "const": "reviewed_collector_pinned_dependencies_and_GitHub_host"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "captured_metric_pass"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "const": null
              },
              "metric_pass": {
                "const": true
              },
              "received_complete_slots": {
                "const": 150
              },
              "complete_original_capture_verified": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "captured_metric_fail"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "const": null
              },
              "metric_pass": {
                "const": false
              },
              "received_complete_slots": {
                "const": 150
              },
              "complete_original_capture_verified": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              }
            }
          }
        }
      ]
    }
  }
}
