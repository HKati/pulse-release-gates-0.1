            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          ]
        },
        "watchdog_arm_begin_ns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          ]
        },
        "watchdog_armed": {
          "type": "boolean"
        },
        "watchdog_unit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 128
            }
          ]
        },
        "watchdog_closed": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/watchdog_closed"
            }
          ]
        },
        "ready": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/row"
            }
          ]
        },
        "response": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/row"
            }
          ]
        }
