              },
              "ActiveState": {
                "const": "inactive"
              }
            }
          }
        },
        "closed_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
