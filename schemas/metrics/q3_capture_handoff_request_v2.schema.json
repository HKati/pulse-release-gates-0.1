{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HKati/pulse-release-gates-0.1/schemas/metrics/q3_capture_handoff_request_v2.schema.json",
  "title": "Q3 continuation capture handoff request v2",
  "description": "Closed continuation envelope. Exact UTF-8 hashes, native-v1/postflight-v1 source, amendment and historical-verification receipt equality, and fresh in-process admission are additional mandatory program checks. No saved approval authorizes execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "repository",
    "capture_source_commit",
    "native_request_utf8",
    "native_request_sha256",
    "postflight_selection_utf8",
    "postflight_selection_sha256",
    "handoff_source_files",
    "authorization"
  ],
  "properties": {
    "record_type": {
      "const": "q3_capture_handoff_request_v2"
    },
    "repository": {
      "const": "HKati/pulse-release-gates-0.1"
    },
    "capture_source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "native_request_utf8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131072
    },
    "native_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "postflight_selection_utf8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131072
    },
    "postflight_selection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "handoff_source_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas/metrics/q3_capture_handoff_request_v2.schema.json",
        "tools/acquire_q3_external_postflight_v1.py",
        "tools/check_q3_external_postflight_v1.py",
        "tools/q3_capture_handoff_v2.py"
      ],
      "properties": {
        "schemas/metrics/q3_capture_handoff_request_v2.schema.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "git_blob_sha1",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 131072
            }
          }
        },
        "tools/acquire_q3_external_postflight_v1.py": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "git_blob_sha1",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 131072
            }
          }
        },
        "tools/check_q3_external_postflight_v1.py": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "git_blob_sha1",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 131072
            }
          }
        },
        "tools/q3_capture_handoff_v2.py": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "git_blob_sha1",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 131072
            }
          }
        }
      }
    },
    "authorization": {
      "const": "AUTHORIZE_ONE_OWNER_203_CALL_CONTINUATION_WITH_FRESH_POSTFLIGHT_HISTORICAL_RECEIPT_AND_30_DAY_RETENTION"
    }
  }
}
