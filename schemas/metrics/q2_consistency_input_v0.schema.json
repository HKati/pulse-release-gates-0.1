{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hkati.github.io/pulse-release-gates-0.1/schemas/metrics/q2_consistency_input_v0.schema.json",
  "title": "Q2 typed final-answer agreement groups v0",
  "description": "Non-active reference input. Supplied grouping and extraction are declared, not authenticated or semantically certified. No aggregate PASS input is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_status",
    "extraction_profile",
    "grouping",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": "q2_consistency_input_v0"
    },
    "record_status": {
      "enum": [
        "synthetic_fixture",
        "archived_response_records"
      ]
    },
    "extraction_profile": {
      "const": "typed_final_answer_or_refusal_v0"
    },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "method_version",
        "seed",
        "sampling_parameters"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}(?![\\s\\S])"
        },
        "method_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}(?![\\s\\S])"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sampling_parameters": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}(?![\\s\\S])"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "responses"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}(?![\\s\\S])"
          },
          "responses": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "response_id",
                    "kind",
                    "answer"
                  ],
                  "properties": {
                    "response_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}(?![\\s\\S])"
                    },
                    "kind": {
                      "const": "answer"
                    },
                    "answer": {
                      "type": "string",
                      "maxLength": 8192
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "response_id",
                    "kind"
                  ],
                  "properties": {
                    "response_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}(?![\\s\\S])"
                    },
                    "kind": {
                      "enum": [
                        "refusal",
                        "unknown"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
