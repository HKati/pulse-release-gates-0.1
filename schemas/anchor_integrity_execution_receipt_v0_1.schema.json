{
  "$id": "https://eplabsai.com/pulsemech/schemas/anchor_integrity_execution_receipt_v0_1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "candidate_status": {
      "const": "diagnostic_only"
    },
    "challenge": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "entrypoint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "input_sha256": {
      "additionalProperties": false,
      "properties": {
        "claim_text": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_content": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_content": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "claim_text",
        "evidence_content",
        "source_content"
      ],
      "type": "object"
    },
    "invocation": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\u0000]*$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "cwd_label": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\u0000]*$",
          "type": "string"
        },
        "environment": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "pattern": "^[A-Z_][A-Z0-9_]{0,63}$",
                "type": "string"
              },
              "value": {
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "argv",
        "cwd_label",
        "environment"
      ],
      "type": "object"
    },
    "observation_basis": {
      "enum": [
        "synthetic_fixture",
        "unattested_observer_statement"
      ]
    },
    "observer": {
      "additionalProperties": false,
      "properties": {
        "implementation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "observer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "observer_id",
        "implementation_sha256"
      ],
      "type": "object"
    },
    "process": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "duration_ms": {
                "maximum": 86400000,
                "minimum": 0,
                "type": "integer"
              },
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "duration_ms": {
                "maximum": 86400000,
                "minimum": 0,
                "type": "integer"
              },
              "exit_code": {
                "maximum": 255,
                "minimum": -255,
                "not": {
                  "const": 0
                },
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_started"
              }
            }
          },
          "then": {
            "properties": {
              "duration_ms": {
                "const": null
              },
              "exit_code": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "timed_out"
              }
            }
          },
          "then": {
            "properties": {
              "duration_ms": {
                "maximum": 86400000,
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        }
      ],
      "properties": {
        "duration_ms": {
          "anyOf": [
            {
              "maximum": 86400000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": -255,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "completed",
            "failed",
            "timed_out",
            "not_started"
          ]
        },
        "stderr_complete": {
          "type": "boolean"
        },
        "stdout_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "exit_code",
        "duration_ms",
        "stdout_complete",
        "stderr_complete"
      ],
      "type": "object"
    },
    "profile": {
      "const": "single-record-execution-contract-v1"
    },
    "record_binding": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "sha256"
      ],
      "type": "object"
    },
    "release_authority_activation": {
      "const": false
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "anchor_integrity_execution_receipt_v0_1"
    },
    "stderr": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.\\-/]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 8388608,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "stdout": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.\\-/]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 8388608,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "run_id"
      ],
      "type": "object"
    },
    "verifier": {
      "additionalProperties": false,
      "properties": {
        "implementation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "method_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "method_version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "verifier_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "verifier_id",
        "method_id",
        "method_version",
        "implementation_sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "candidate_status",
    "authority_effect",
    "release_authority_activation",
    "profile",
    "execution_id",
    "challenge",
    "request_sha256",
    "record_binding",
    "subject",
    "verifier",
    "observation_basis",
    "observer",
    "entrypoint_sha256",
    "runtime_manifest_sha256",
    "input_sha256",
    "invocation",
    "process",
    "stdout",
    "stderr"
  ],
  "title": "anchor_integrity_execution_receipt_v0_1 - diagnostic contract only",
  "type": "object"
}
