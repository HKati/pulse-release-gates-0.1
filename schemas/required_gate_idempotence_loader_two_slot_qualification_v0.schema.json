            },
            "ipc": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^ipc:\\[[1-9][0-9]*\\]$"
            },
            "mnt": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^mnt:\\[[1-9][0-9]*\\]$"
            },
            "net": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^net:\\[[1-9][0-9]*\\]$"
            },
            "pid": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^pid:\\[[1-9][0-9]*\\]$"
            },
            "pid_for_children": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^pid:\\[[1-9][0-9]*\\]$"
            },
            "time": {
              "anyOf": [
