          "const": "fixed_1980_01_01_00_00_00"
        },
        "zip64": {
          "const": "forbidden"
        },
        "archive_member_set": {
          "const": "exact_payload_paths_plus_manifest_and_package_signature"
        },
        "crc32": {
          "const": "required_and_verified"
        },
        "duplicate_member_names": {
          "const": "forbidden"
        },
        "local_central_directory_consistency": {
          "const": "required"
        },
        "trailing_data": {
          "const": "forbidden"
        }
      }
    },
