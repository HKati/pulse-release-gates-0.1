{
  "$id": "https://github.com/HKati/pulse-release-gates-0.1/schemas/pulsemech_device_ledger_manifest_v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PULSEmech Device Ledger Package Manifest v0",
  "description": "Closed manifest contract for the bounded .pulseledger ZIP carrier used by the PULSEmech iPhone Device Transition Ledger foundation. The manifest binds exact payload-member bytes, the canonical ledger identity, checkpoint closure, observer key identity, package layout and signature roles without becoming device-control or release authority.",
  "$comment": "Semantic verification requirements: the verifier must parse the ZIP without extraction, reconstruct the exact member-name set as payload member paths plus the fixed manifest and package-signature paths, reject duplicates and unsafe members, verify exact member bytes against every declared digest and size, verify the four fixed contract/schema member identities, require the observer-public-key member digest to equal observer_public_key_fingerprint_sha256, require ledger member digest and size to equal ledger_binding, reconstruct ledger summaries and checkpoint_record_sha256 from the ledger, validate checkpoint and package signature documents with pulsemech_device_signature_v0, reconstruct the package-signature subject from the canonical manifest bytes, and compute the exact carrier SHA-256 externally. The manifest never inventories itself or the package-signature member, avoiding circularity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_boundary",
    "carrier_contract",
    "claim_boundary",
    "created_unix_ns",
    "document_type",
    "ledger_binding",
    "manifest_contract",
    "observer_binding",
    "package_format",
    "package_member_count",
    "payload_member_count",
    "payload_members",
    "record_status",
    "reference_device_class",
    "reference_platform",
    "schema_version",
    "signature_contract"
  ],
  "properties": {
    "authority_boundary": {
      "$ref": "#/$defs/authority_boundary"
    },
    "carrier_contract": {
      "$ref": "#/$defs/carrier_contract"
    },
    "claim_boundary": {
      "$ref": "#/$defs/claim_boundary"
    },
    "created_unix_ns": {
      "$ref": "#/$defs/i63_nonnegative"
    },
    "document_type": {
      "const": "pulsemech_device_ledger_manifest"
    },
    "ledger_binding": {
      "$ref": "#/$defs/ledger_binding"
    },
    "manifest_contract": {
      "$ref": "#/$defs/manifest_contract"
    },
    "observer_binding": {
      "$ref": "#/$defs/observer_binding"
    },
    "package_format": {
      "const": "pulseledger_zip_v0"
    },
    "package_member_count": {
      "const": 10
    },
    "payload_member_count": {
      "const": 8
    },
    "payload_members": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "$ref": "#/$defs/canonicalization_profile_member"
        },
        {
          "$ref": "#/$defs/observation_contract_member"
        },
        {
          "$ref": "#/$defs/observer_public_key_member"
        },
        {
          "$ref": "#/$defs/transition_ledger_member"
        },
        {
          "$ref": "#/$defs/manifest_schema_member"
        },
        {
          "$ref": "#/$defs/signature_schema_member"
        },
        {
          "$ref": "#/$defs/transition_ledger_schema_member"
        },
        {
          "$ref": "#/$defs/checkpoint_signature_member"
        }
      ],
      "items": false
    },
    "record_status": {
      "type": "string",
      "enum": [
        "synthetic_reference",
        "observed"
      ]
    },
    "reference_device_class": {
      "const": "iphone"
    },
    "reference_platform": {
      "const": "ios"
    },
    "schema_version": {
      "const": "pulsemech_device_ledger_manifest_v0"
    },
    "signature_contract": {
      "$ref": "#/$defs/signature_contract"
    }
  },
