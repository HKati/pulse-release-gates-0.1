    "historical_input_isolation": {
      "const": "not_verified"
    },
    "claim_scope": {
      "const": "candidate_structures"
    },
    "model_quality": {
      "const": "not_evaluated"
    },
    "reference_agreement": {
      "const": "not_evaluated"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "minItems": 23,
      "maxItems": 23
