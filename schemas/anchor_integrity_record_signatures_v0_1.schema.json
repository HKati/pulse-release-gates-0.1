{
  "$id": "https://eplabsai.com/pulsemech/schemas/anchor_integrity_record_signatures_v0_1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "candidate_status": {
      "const": "diagnostic_only"
    },
    "profile": {
      "const": "pinned-ed25519-record-signers-v1"
    },
    "record_set_binding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "release_authority_activation": {
      "const": false
    },
    "schema_version": {
      "const": "anchor_integrity_record_signatures_v0_1"
    },
    "signatures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "record_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    },
    "trust_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "candidate_status",
    "authority_effect",
    "release_authority_activation",
    "profile",
    "record_set_binding",
    "trust_policy_sha256",
    "signatures"
  ],
  "title": "anchor_integrity_record_signatures_v0_1",
  "type": "object"
}
