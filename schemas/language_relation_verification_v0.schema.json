          "enum": [
            "directly_observed",
            "partially_observed",
            "reconstructed",
            "hypothesized",
            "not_observed"
          ]
        },
        "binding_status": {
          "enum": [
            "bound",
            "partially_bound",
            "unbound",
            "stale",
            "identity_conflict"
          ]
        },
        "consistency_status": {
          "enum": [
            "consistent",
            "ambiguous",
            "conflicting",
            "internally_incomplete"
          ]
        },
        "reproduction_status": {
          "enum": [
            "reproduced",
            "bounded_replay_only",
            "not_reproduced",
            "not_tested",
            "not_reproducible"
          ]
        },
        "causal_status": {
          "enum": [
            "not_evaluated",
            "sequence_only",
            "correlated",
            "contributory_supported",
            "enabling_supported",
            "sufficiency_supported",
            "necessity_supported",
            "exclusive_path_supported",
            "conflicting",
            "unresolved"
          ]
        },
        "authority_status": {
          "const": "none"
        }
      },
      "required": [
        "observation_status",
        "binding_status",
        "consistency_status",
        "reproduction_status",
        "causal_status",
        "authority_status"
      ],
      "additionalProperties": false
    },
    "argument_value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
