            }
          },
          "required": [
            "op",
            "antecedent",
            "consequent"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "FORALL",
                "EXISTS"
              ]
            },
            "variable": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "domain_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "body": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "variable",
            "domain_id",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "REF"
            },
            "relation_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "op",
            "relation_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "CONTEXT"
            },
            "discourse_type": {
              "enum": [
                "assertion",
                "quotation",
                "supposition"
              ]
            },
            "modality": {
              "enum": [
                "declarative",
                "permission",
                "obligation",
                "observed_event"
              ]
            },
            "speaker_entity_id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                }
              ]
            },
            "body": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "discourse_type",
            "modality",
            "speaker_entity_id",
            "body"
          ],
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
