              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "entity_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "variable": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "variable"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "relation_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "relation_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "ATOM"
            },
            "predicate": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "value": {
                    "$ref": "#/$defs/argument_value"
                  }
                },
                "required": [
                  "role",
                  "value"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 12
            }
          },
          "required": [
            "op",
            "predicate",
            "arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "NOT"
            },
            "operand": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "operand"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "AND",
                "OR"
              ]
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 12
            }
          },
          "required": [
            "op",
            "operands"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
