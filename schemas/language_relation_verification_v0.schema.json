          "minItems": 1,
          "uniqueItems": true
        },
        "discourse_type": {
          "enum": [
            "assertion",
            "quotation",
            "supposition"
          ]
        },
        "modality": {
          "enum": [
            "declarative",
            "permission",
            "obligation",
            "observed_event"
          ]
        },
        "speaker_entity_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            }
          ]
        }
      },
      "required": [
        "relation_id",
        "expression",
        "anchor_ids",
        "discourse_type",
        "modality",
        "speaker_entity_id"
      ],
      "additionalProperties": false
    },
    "representation": {
      "type": "object",
      "properties": {
        "representation_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "entities": {
          "type": "array",
          "items": {
