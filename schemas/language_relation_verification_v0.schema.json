                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "entity_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "domain_id",
              "entity_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0
        },
        "groups": {
