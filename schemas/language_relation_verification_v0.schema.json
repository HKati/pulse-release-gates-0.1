{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HKati/pulse-release-gates-0.1/schemas/language_relation_verification_v0.schema.json",
  "title": "language_relation_verification_v0",
  "$comment": "LRM-01 structural contract only. Schema validity is not verified evidence, semantic measurement, or release authority.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "language_relation_verification_v0"
    },
    "artifact_kind": {
      "const": "language_relation_verification"
    },
    "provenance": {
      "enum": [
        "synthetic_contract_example",
        "verification_run"
      ]
    },
    "verification_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "input_ref": {
      "$ref": "#/$defs/artifact_ref"
    },
    "profile_ref": {
      "$ref": "#/$defs/profile_ref"
    },
    "checker_ref": {
      "$ref": "#/$defs/tool_ref"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "kind": {
            "enum": [
              "source_binding",
              "subject_binding",
              "representation_mapping",
              "reference_acceptance",
              "coverage",
              "correspondence"
            ]
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "not_run",
              "completed",
              "error"
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "pass",
                  "fail",
                  "unresolved"
                ]
              }
            ]
          },
          "reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "check_id",
          "kind",
          "target_ids",
          "status",
          "result",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "not_run",
                    "error"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "result": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "result": {
                  "enum": [
                    "pass",
                    "fail",
                    "unresolved"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "result": {
                  "enum": [
                    "fail",
                    "unresolved"
                  ]
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "basis_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "side": {
            "enum": [
              "before",
              "after"
            ]
          },
          "representation_basis": {
            "enum": [
              "candidate_only",
              "accepted_reference",
              "profile_verified"
            ]
          },
          "claim_scope": {
            "enum": [
              "candidate_structures",
              "reference_interpretation",
              "controlled_source_profile"
            ]
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "acceptance_ref": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/acceptance_ref"
              }
            ]
          },
          "reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        "required": [
          "side",
          "representation_basis",
          "claim_scope",
          "check_ids",
          "acceptance_ref",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "representation_basis": {
                  "const": "candidate_only"
                }
              },
              "required": [
                "representation_basis"
              ]
            },
            "then": {
              "properties": {
                "claim_scope": {
                  "const": "candidate_structures"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "representation_basis": {
                  "const": "accepted_reference"
                }
              },
              "required": [
                "representation_basis"
              ]
            },
            "then": {
              "properties": {
                "claim_scope": {
                  "const": "reference_interpretation"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "representation_basis": {
                  "const": "profile_verified"
                }
              },
              "required": [
                "representation_basis"
              ]
            },
            "then": {
              "properties": {
                "claim_scope": {
                  "const": "controlled_source_profile"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "representation_basis": {
                  "const": "candidate_only"
                }
              },
              "required": [
                "representation_basis"
              ]
            },
            "then": {
              "properties": {
                "acceptance_ref": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "representation_basis": {
                  "enum": [
                    "accepted_reference",
                    "profile_verified"
                  ]
                }
              },
              "required": [
                "representation_basis"
              ]
            },
            "then": {
              "properties": {
                "check_ids": {
                  "minItems": 1
                },
                "acceptance_ref": {
                  "$ref": "#/$defs/acceptance_ref"
                }
              }
            }
          }
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "status_axes": {
      "$ref": "#/$defs/status_axes"
    },
    "authority_effect": {
      "const": "none"
    },
    "release_authority_activation": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "provenance",
    "verification_id",
    "input_ref",
    "profile_ref",
    "checker_ref",
    "checks",
    "basis_records",
    "status_axes",
    "authority_effect",
    "release_authority_activation"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:\\x00-\\x1f])(?!.*\\/$)[A-Za-z0-9_./-]+$"
    },
    "profile_ref": {
      "type": "object",
      "properties": {
        "profile_id": {
          "const": "lrm_finite_reference_profile_v0"
