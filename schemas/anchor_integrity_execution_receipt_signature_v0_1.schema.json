{
  "$id": "https://eplabsai.com/pulsemech/schemas/anchor_integrity_execution_receipt_signature_v0_1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "candidate_status": {
      "const": "diagnostic_only"
    },
    "execution_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "key_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "observer_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "observer_policy_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "profile": {
      "const": "pinned-ed25519-execution-observers-v1"
    },
    "receipt_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "record_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "record_signer_policy_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "release_authority_activation": {
      "const": false
    },
    "schema_version": {
      "const": "anchor_integrity_execution_receipt_signature_v0_1"
    },
    "signature_domain": {
      "const": "PULSEMECH-ANCHOR-EXECUTION-RECEIPT-SIGNATURE-V1"
    },
    "signature_hex": {
      "maxLength": 128,
      "minLength": 128,
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    },
    "signature_suite": {
      "const": "ed25519"
    }
  },
  "required": [
    "schema_version",
    "candidate_status",
    "authority_effect",
    "release_authority_activation",
    "profile",
    "signature_suite",
    "signature_domain",
    "key_id",
    "observer_policy_sha256",
    "record_signer_policy_sha256",
    "receipt_sha256",
    "observer_id",
    "execution_id",
    "record_id",
    "signature_hex"
  ],
  "title": "anchor_integrity_execution_receipt_signature_v0_1 - diagnostic receipt statement only",
  "type": "object"
}
