        },
        "subject_observation_authentication": {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "result": {
              "const": null
            },
            "status": {
              "const": "not_run"
            }
          },
          "required": [
            "status",
