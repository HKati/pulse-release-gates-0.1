{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulsemech:required-gate-idempotence-containment:v0",
  "title": "Selected idempotence containment preparation v0",
  "$ref": "#/$defs/selection",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "profile",
        "record_status",
        "bootstrap_plan_sha256",
        "phase",
        "launcher",
        "entry_shim",
        "entry_source",
        "policy_source",
        "execution_ready",
        "execution_authorized",
        "runtime_closure_verified",
        "restored_bootstrap_qualified",
        "containment_enforced",
        "production_gate_eligible",
        "authority_effect"
      ],
      "properties": {
        "record_type": {
          "const": "required_gate_idempotence_containment_selection_v0"
        },
        "profile": {
          "const": "linux_x86_64_bubblewrap_bootstrap_v0"
        },
        "record_status": {
          "enum": [
            "example",
            "selected"
          ]
        },
        "bootstrap_plan_sha256": {
          "$ref": "#/$defs/digest"
        },
        "phase": {
          "enum": [
            "worker",
            "collector"
          ]
        },
        "launcher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 500,
              "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$"
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "entry_shim": {
          "$ref": "#/$defs/binary"
        },
        "entry_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "const": "tools/required_gate_idempotence_containment_entry_v0.c"
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 524288
            }
          }
        },
        "policy_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "const": "tools/required_gate_idempotence_containment_policy_v0.py"
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 524288
            }
          }
        },
        "execution_ready": {
          "const": false
        },
        "execution_authorized": {
          "const": false
        },
        "runtime_closure_verified": {
          "const": false
        },
        "restored_bootstrap_qualified": {
          "const": false
        },
        "containment_enforced": {
          "const": false
        },
        "production_gate_eligible": {
          "const": false
        },
        "authority_effect": {
          "const": "none"
        }
      }
    }
  }
}
