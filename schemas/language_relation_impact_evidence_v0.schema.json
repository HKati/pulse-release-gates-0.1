{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HKati/pulse-release-gates-0.1/schemas/language_relation_impact_evidence_v0.schema.json",
  "title": "language_relation_impact_evidence_v0",
  "$comment": "LRM-04 independently configured impact premises. Hashes bind content, not authenticity. Package-local self-acceptance is forbidden. A passing reference review does not establish world truth, causal impact, target appropriateness, controlled-profile verification, or release authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/trust_config"
    },
    {
      "$ref": "#/$defs/impact_review"
    },
    {
      "$ref": "#/$defs/impact_observation"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:\\x00-\\x1f])(?!.*\\/$)[A-Za-z0-9_./-]+$"
    },
    "file_pin": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    "artifact_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "artifact_id",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    "profile_ref": {
      "type": "object",
      "properties": {
        "profile_id": {
          "const": "lrm_finite_reference_profile_v0"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "profile_id",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    "source_binding": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "before",
            "after",
            "context"
          ]
        },
        "language": {
          "enum": [
            "hu",
            "en",
            "und"
          ]
        },
        "revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "source_id",
        "role",
        "language",
        "revision",
        "content_sha256",
        "byte_length"
      ],
      "additionalProperties": false
    },
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_ref": {
      "type": "object",
      "properties": {
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "model_id",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    "observation_ref": {
      "type": "object",
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/id"
        },
        "subject_id": {
          "$ref": "#/$defs/instance_id"
        },
        "run_id": {
          "$ref": "#/$defs/instance_id"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "observation_id",
        "subject_id",
        "run_id",
        "event_id"
      ],
      "additionalProperties": false
    },
    "scope_check": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "completed",
            "not_run",
            "error"
          ]
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unresolved",
            null
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "context_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "correspondence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "withdrawal_semantics": {
          "enum": [
            "remove_base_evidence",
            null
          ]
        }
      },
      "required": [
        "check_id",
        "status",
        "result",
        "reason",
        "evidence_refs",
        "context_source_ids",
        "correspondence_ids",
        "withdrawal_semantics"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_run",
                  "error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unresolved"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "fail",
                  "unresolved"
                ]
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "description": "Independent acceptance of the exact target-to-claim/event mapping, all scoped claim meanings and typing, correspondence and context, plus base-evidence withdrawal semantics. This does not establish target appropriateness or world truth."
    },
    "base_check": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "completed",
            "not_run",
            "error"
          ]
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unresolved",
            null
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "claim_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "check_id",
        "status",
        "result",
        "reason",
        "evidence_refs",
        "claim_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_run",
                  "error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unresolved"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "fail",
                  "unresolved"
                ]
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "rule_check": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "completed",
            "not_run",
            "error"
          ]
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unresolved",
            null
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "rule_id": {
          "$ref": "#/$defs/id"
        },
        "rule_basis_ref": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "check_id",
        "status",
        "result",
        "reason",
        "evidence_refs",
        "rule_id",
        "rule_basis_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_run",
                  "error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unresolved"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "fail",
                  "unresolved"
                ]
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "observation_check": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "completed",
            "not_run",
            "error"
          ]
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unresolved",
            null
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "method": {
          "const": "independent_event_observation"
        }
      },
      "required": [
        "check_id",
        "status",
        "result",
        "reason",
        "evidence_refs",
        "method"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_run",
                  "error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unresolved"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "fail",
                  "unresolved"
                ]
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "trust_config": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "language_relation_impact_trust_config_v0"
        },
        "review_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_pin"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "observation_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_pin"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "review_files",
        "observation_files"
      ],
      "additionalProperties": false
    },
    "impact_review": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "language_relation_impact_review_v0"
        },
        "verification_id": {
          "$ref": "#/$defs/id"
        },
        "input_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "profile_ref": {
          "$ref": "#/$defs/profile_ref"
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "enum": [
            "support",
            "observed"
          ]
        },
        "model_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/model_ref"
            }
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reviewed_variant_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "scope_check": {
          "$ref": "#/$defs/scope_check"
        },
        "base_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/base_check"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "rule_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule_check"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "observation_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/observation_ref"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "verification_id",
        "input_ref",
        "profile_ref",
        "target_id",
        "mode",
        "model_ref",
        "claim_ids",
        "reviewed_variant_ids",
        "scope_check",
        "base_checks",
        "rule_checks",
        "observation_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "support"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "model_ref": {
                "$ref": "#/$defs/model_ref"
              },
              "claim_ids": {
                "minItems": 1
              },
              "observation_ref": {
                "type": "null"
              },
              "scope_check": {
                "properties": {
                  "withdrawal_semantics": {
                    "const": "remove_base_evidence"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "observed"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "model_ref": {
                "type": "null"
              },
              "claim_ids": {
                "maxItems": 0
              },
              "base_checks": {
                "maxItems": 0
              },
              "rule_checks": {
                "maxItems": 0
              },
              "observation_ref": {
                "$ref": "#/$defs/observation_ref"
              },
              "scope_check": {
                "properties": {
                  "withdrawal_semantics": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "impact_observation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "language_relation_impact_observation_v0"
        },
        "observation_id": {
          "$ref": "#/$defs/id"
        },
        "input_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "profile_ref": {
          "$ref": "#/$defs/profile_ref"
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "reviewed_variant_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "processing_id": {
          "$ref": "#/$defs/id"
        },
        "subject_id": {
          "$ref": "#/$defs/instance_id"
        },
        "run_id": {
          "$ref": "#/$defs/instance_id"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "before_value": {
          "type": "boolean"
        },
        "after_value": {
          "type": "boolean"
        },
        "source_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_binding"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "check": {
          "$ref": "#/$defs/observation_check"
        }
      },
      "required": [
        "schema_version",
        "observation_id",
        "input_ref",
        "profile_ref",
        "target_id",
        "reviewed_variant_ids",
        "processing_id",
        "subject_id",
        "run_id",
        "event_id",
        "before_value",
        "after_value",
        "source_bindings",
        "check"
      ],
      "additionalProperties": false,
      "description": "Separately pinned independent before/after event observation. Exact input, profile, target, variants, processing instance, subject/run/event and source-instance bindings are required. The values describe the reviewed event outcome and do not establish causality."
    }
  }
}
