{
  "$id": "https://eplabsai.com/pulsemech/schemas/anchor_integrity_observer_policy_v0_1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "candidate_status": {
      "const": "diagnostic_only"
    },
    "execution_scope": {
      "additionalProperties": false,
      "properties": {
        "challenge": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "execution_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "request_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "execution_id",
        "challenge",
        "request_sha256"
      ],
      "type": "object"
    },
    "key_separation": {
      "const": "observer_key_not_in_verifier_policy"
    },
    "keys": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "key_id": {
            "maxLength": 128,
            "minLength": 1,
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "not_after_epoch": {
            "maximum": 253402300799,
            "minimum": 0,
            "type": "integer"
          },
          "not_before_epoch": {
            "maximum": 253402300799,
            "minimum": 0,
            "type": "integer"
          },
          "observation_bases": {
            "items": {
              "enum": [
                "synthetic_fixture",
                "unattested_observer_statement"
              ],
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "public_key_hex": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "public_key_sha256": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "purpose": {
            "const": "execution_receipt_statement"
          },
          "relation_types": {
            "items": {
              "enum": [
                "supports",
                "contradicts",
                "derived_from",
                "contextualizes",
                "references"
              ],
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "results": {
            "items": {
              "enum": [
                "supported",
                "contradicted",
                "insufficient",
                "unresolved"
              ],
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "signature_suite": {
            "const": "ed25519"
          },
          "state": {
            "enum": [
              "active",
              "revoked"
            ]
          },
          "verifier": {
            "additionalProperties": false,
            "properties": {
              "implementation_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "method_id": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "method_version": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "verifier_id": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string"
              }
            },
            "required": [
              "verifier_id",
              "method_id",
              "method_version",
              "implementation_sha256"
            ],
            "type": "object"
          }
        },
        "required": [
          "key_id",
          "signature_suite",
          "purpose",
          "public_key_hex",
          "public_key_sha256",
          "state",
          "not_before_epoch",
          "not_after_epoch",
          "verifier",
          "relation_types",
          "results",
          "observation_bases"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "observer": {
      "additionalProperties": false,
      "properties": {
        "implementation_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "observer_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "observer_id",
        "implementation_sha256"
      ],
      "type": "object"
    },
    "policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "profile": {
      "const": "pinned-ed25519-execution-observers-v1"
    },
    "record_signer_policy_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "release_authority_activation": {
      "const": false
    },
    "schema_version": {
      "const": "anchor_integrity_observer_policy_v0_1"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "run_id"
      ],
      "type": "object"
    },
    "trust_domain": {
      "enum": [
        "TEST",
        "OPERATOR"
      ]
    }
  },
  "required": [
    "schema_version",
    "candidate_status",
    "authority_effect",
    "release_authority_activation",
    "profile",
    "policy_id",
    "trust_domain",
    "subject",
    "record_signer_policy_sha256",
    "observer",
    "execution_scope",
    "key_separation",
    "keys"
  ],
  "title": "anchor_integrity_observer_policy_v0_1 - diagnostic receipt statement only",
  "type": "object"
}
