{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsemech.dev/schemas/required_gate_idempotence_loader_two_slot_attempt_v0.schema.json",
  "title": "Loader two-slot qualification attempt v0",
  "description": "A bounded preserved attempt. Complete and incomplete records, and native-declared and scripted origins, remain distinct; reconstruction does not authenticate physical execution.",
  "type": "object",
  "properties": {
    "record_type": {
      "type": "string",
      "const": "required_gate_idempotence_loader_two_slot_attempt_v0"
    },
    "profile": {
      "type": "string",
      "const": "linux_x86_64_loader_two_slot_attempt_v0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request": {
      "type": "object",
      "properties": {
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "size_bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "incomplete"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "admission",
        "qualification",
        "verification",
        "publication",
        "complete"
      ]
    },
    "failure": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "producer_invocations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_origin": {
      "type": "string",
      "enum": [
        "not_invoked",
        "native_owned_probe",
        "scripted_test_backend"
      ]
    },
    "context_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/context"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/context"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources_before": {
      "anyOf": [
