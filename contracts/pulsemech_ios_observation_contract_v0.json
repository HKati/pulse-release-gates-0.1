      },
      "normalized_state": {
        "activation_state_values": [
          "foreground_active",
          "foreground_inactive",
          "background",
          "unattached",
          "unknown"
        ]
      },
      "scene_scope": "one_bound_uiscene_session_per_observer_session",
      "snapshot_sampling": "capture_bound_uiscene_activation_state_on_main_actor_then_submit_immutable_normalized_value_to_ledger_queue",
      "source_interface": "UIKit UIScene.activationState and UISceneDelegate lifecycle callbacks",
      "surface_id": "app_lifecycle",
      "unknown_enum_rule": "map_to_unknown"
    },
    {
      "availability_states": [
        "observed",
        "unavailable",
        "unsupported"
      ],
      "event_contract": {
        "event_target_projection": "exact_normalized_path_update_callback_argument",
        "event_value": "path_update_received",
        "event_admission": "accept_only_while_observation_window_is_open_and_session_is_active",
        "initiating_cause_claim": "forbidden"
      },
      "initial_observation_rule": "surface_unavailable_until_first_path_update_callback",
      "normalization_rules": {
        "available_interface_types": "map_path_available_interfaces_without_name_or_index_deduplicate_then_sort_by_declared_order",
        "future_interface_type": "unknown",
        "status_unknown_default": "unknown",
        "used_interface_types": "collect_known_types_for_which_path_uses_interface_type_is_true_then_sort_by_declared_order"
      },
      "normalized_state": {
        "available_interface_type_order": [
          "wifi",
          "cellular",
          "wired_ethernet",
          "loopback",
          "other",
          "unknown"
        ],
        "boolean_properties": [
          "is_expensive",
          "is_constrained",
          "supports_ipv4",
          "supports_ipv6",
          "supports_dns"
        ],
        "status_values": [
          "satisfied",
          "unsatisfied",
          "requires_connection",
          "unknown"
        ],
        "used_interface_type_order": [
          "wifi",
          "cellular",
          "wired_ethernet",
          "loopback",
          "other"
        ]
      },
      "snapshot_sampling": "normalize_callback_argument_once_without_later_current_path_reopen",
      "source_interface": "Network.framework NWPathMonitor.pathUpdateHandler",
      "source_scope": "application_visible_process_context",
      "surface_id": "network_path"
    }
  ],
  "observer_execution_contract": {
    "callback_ingress": "immutable_source_observation_submitted_to_one_serial_ledger_queue",
    "cross_source_sequence_rule": "ledger_queue_acceptance_order",
    "late_network_event_after_session_close": "rejected",
    "network_monitor_queue": "same_serial_ledger_queue",
    "record_sequence_assignment": "after_normalization_on_serial_ledger_queue",
    "reentrant_record_construction": "forbidden",
