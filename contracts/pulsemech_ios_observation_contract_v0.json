  "coverage_contract": {
    "continuous_interval": {
      "does_not_claim": [
        "complete_hidden_event_capture",
        "continuous_cpu_execution"
      ],
      "meaning": "no_declared_observation_gap_between_consecutive_bound_endpoints",
      "observation_coverage_status": "continuous",
      "required_relations": [
        "same_session_id",
        "same_clock_epoch_id",
        "source_snapshot_precedes_target_snapshot",
        "no_coverage_interval_record_between_endpoints"
      ]
    },
    "cross_gap_transition": {
      "causal_necessity_status": "not_established",
      "causal_sufficiency_status": "not_established",
      "alternative_path_closure_status": "open",
      "initiating_event_unix_ns": "must_be_null",
      "initiating_source_identity": "must_be_null",
      "initiating_source_status": "unavailable_from_platform",
      "observation_coverage_status": "gap_between_endpoints",
      "endpoint_binding_status": "verified",
      "endpoint_observation_source_binding_status": "all_bound",
      "relation_change_observation_status": "all_endpoint_difference_observed",
      "time_order_status": "sequence_verified",
      "transition_path_verification_status": "endpoint_difference_only"
    },
    "interrupted_interval": {
      "observation_coverage_status": "gap_between_endpoints",
      "required_relations": [
        "explicit_coverage_interval_record",
        "coverage_state_is_unobserved_or_unavailable",
        "source_snapshot_is_last_bound_snapshot_before_window_close",
        "target_snapshot_is_first_bound_snapshot_after_window_reopens"
      ]
    }
  },
  "document_storage": {
    "digest_algorithm": "SHA-256",
    "digest_subject": "exact_repository_file_bytes",
    "self_canonicalization_claim": false
  },
  "document_type": "pulsemech_ios_observation_contract",
  "event_binding_contract": {
    "event_observed_requirements": [
      "source_snapshot_precedes_observation_event",
      "observation_event_precedes_target_snapshot",
      "same_session_id",
      "same_clock_epoch_id",
      "same_surface_id",
      "event_target_projection_equals_target_snapshot_surface",
      "no_coverage_interval_record_between_bound_records"
    ],
    "missing_or_unbound_event_result": "endpoint_difference_observed_only_when_both_endpoint_surfaces_are_bound_else_no_transition",
    "observation_source_role": "reporting_interface_not_initiating_cause",
    "zero_normalized_difference_rule": "retain_event_without_transition_record"
  },
  "measurement_class": "platform_reported_runtime_state",
  "observation_mode": "foreground_scene_session_with_explicit_coverage_gaps",
  "observation_surfaces": [
    {
      "availability_states": [
        "observed",
        "unavailable",
        "unsupported"
      ],
      "event_contract": {
        "normalized_event_values": [
          "scene_did_become_active",
          "scene_will_resign_active",
          "scene_did_disconnect"
        ],
        "observation_window_close_events": [
