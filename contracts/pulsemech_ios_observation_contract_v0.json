    "monotonic_scope": "clock_epoch_id",
    "sequence_rule": "strictly_increasing_by_one_from_zero",
    "wall_clock_integer_range": "0..9223372036854775807",
    "wall_clock_out_of_range_rule": "reject_observation",
    "wall_clock_role": "recorded_observation_not_ordering_authority",
    "wall_clock_unit": "unix_nanoseconds"
